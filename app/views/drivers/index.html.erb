<h1>Drivers</h1>

<table>
  <tr>
    <th>Driver</th>
    <th>Country</th>
  </tr>
  <% @drivers.each do |driver| %>
    <tr>
      <td>
        <% if driver.alias.present? %>
          <%= link_to driver.alias, driver %>
        <% else %>
          <%= driver.user.name %>
        <% end %>
      </td>
      <td><%= driver.country %></td>
    </tr>
  <% end %>
</table>