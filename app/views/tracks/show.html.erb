<div>
  <h1><%= @track.name %></h1>
  <h4><%= @track.circuit.name %></h4>

  <h2>Races</h2>
  <%= link_to "Add Race", new_race_path(track_id: @track.id) %>

  <table>
    <tr>
      <th>Driver</th>
      <th>Start Time</th>
      <th>Total Laps</th>
      <th>Best Lap Time</th>
      <th>Avg Lap Time</th>
    </tr>
    <% @races.each do |race| %>
      <tr>
        <td><%= race.driver.alias %></td>
        <td><%= race.start_time.strftime("%H:%M:%S") %></td>
        <td><%= race.total_laps %></td>
        <td><%= race.best_lap_time %></td>
        <td><%= race.avg_lap_time %></td>
      </tr>
    <% end %>
  </table>

  <p><%= link_to "Back to tracks", tracks_path %></p>
</div>