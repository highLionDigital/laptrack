<div class="container px-4 py-5">
  <h2 class="pb-2 border-bottom">Add a new track</h2>

  <div class="row">
    <div class="col-md-6">
      <%= render "form", track: @track %>
    </div>

    <div class="col-md-6">
      <%= image_tag 'tracks/track1.jpg', class: 'img-fluid' %>
    </div>
  </div>

  <%= link_to "Back", :back, class: 'mt-3 d-inline-block' %>
</div>
