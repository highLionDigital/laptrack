<%= form_with(model: [@circuit, @track], local: true) do |form| %>

  <div class="row mb-3">
    <%= form.label :name, class: "col-sm-2 col-form-label" %><br>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="row mb-3">
    <legend class="col-form-label col-sm-2 pt-0">Type</legend>
    <div class="col-sm-10">
      <%= form.collection_radio_buttons :location, Track::LOCATIONS, :to_s, :titleize do |b| %>
        <div class="form-check">
          <%= b.radio_button class: "form-check-input", type: "radio" %>
          <%= b.label class: "form-check-label" %>
        </div>
      <% end %>
    </div>
  </div>

  <div>
    <%= form.submit "Add Track", class: "btn btn-primary" %>
  </div>

<% end %>
