<div class="container px-4 py-5">
  <h2 class="pb-2 border-bottom">Tracks</h2>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>Track Name</th>
        <th>Circuit Name</th>
        <th>Driver with Best Time</th>
        <th>Overall Best Time</th>
      </tr>
    </thead>
    <tbody>
      <% @tracks.each do |track| %>
        <tr>
          <td><%= link_to track.name, track %></td>
          <td><%= link_to track.circuit.name, track.circuit %></td>
          <% best_race = track.races.min_by(&:best_lap_time) %>
          <td><%= best_race&.driver&.alias || 'No races yet' %></td>
          <td><%= @best_times[track.id]&.best_lap_time || 'N/A' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
    
</div>
