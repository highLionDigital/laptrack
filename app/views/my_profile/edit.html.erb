<div class="container px-4 py-5">
  <h2 class="pb-2 border-bottom">Edit your driver profile</h2>

  <%= form_with(model: @current_driver, url: my_profile_path, method: :patch, local: true) do |form| %>
    <% if @current_driver.errors.any? %>
      <div id="error_explanation">
        <h2><%= pluralize(@current_driver.errors.count, "error") %> prohibited this profile from being saved:</h2>
        <ul>
          <% @current_driver.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= form.label :alias %>
      <%= form.text_field :alias %>
    </div>

    <div class="field">
      <%= form.label :dob, "Date of Birth" %>
      <%= form.date_field :dob %>
    </div>

    <div class="field">
      <%= form.label :country %>
      <%= form.text_field :country %>
    </div>

    <div class="field">
      <%= form.label :bio %>
      <%= form.text_area :bio %>
    </div>

    <div class="actions">
      <%= form.submit "Update Profile" %>
    </div>
  <% end %>

  <%= link_to 'Back to Profile', my_profile_path %>
  
</div>
